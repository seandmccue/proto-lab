# ProtoLab — model configuration
# Meta Model API (https://dev.meta.ai/docs/overview). OpenAI-compatible chat completions with tool calling.
MODEL_API_BASE=https://api.meta.ai/v1
# Model id enabled in your account: muse-spark-1.3 (default), muse-spark-1.1, muse-wonder-1.0, ...
MODEL_ID=muse-spark-1.3
# MODEL_API_KEY from dev.meta.ai. Server-side only; never shipped to the client. Leave empty to run the deterministic planner (no AI).
MODEL_API_KEY=
# Engineering specialist consulted after MODEL_SPECIALIST_AFTER consecutive failed walk tests (empty = off)
MODEL_SPECIALIST_ID=muse-wonder-1.0
MODEL_SPECIALIST_AFTER=3
# API server
PORT=8787
DATA_DIR=./data
# Wall-clock budget per build in seconds; after it the model is asked to finalize with the best result so far
AGENT_TIME_BUDGET_S=1200
# Builds that may run at the same time (each in its own worker thread)
JOB_CONCURRENCY=3
# Output budget per model round (reasoning counts); 8192 is faster on simple prompts but risks cut-offs
MODEL_MAX_TOKENS=16384
