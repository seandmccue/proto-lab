# ProtoLab — model configuration
# OpenAI-compatible chat completions endpoint. Meta's Llama API compat endpoint by default.
LLM_BASE_URL=https://api.llama.com/compat/v1
# Exact model id enabled in your account (verify in the Meta developer dashboard).
LLM_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
# Your Meta API key. Leave empty to run the deterministic planner (no AI).
LLM_API_KEY=
# API server
PORT=8787
DATA_DIR=./data
